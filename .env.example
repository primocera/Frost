# Host of the deployed game server Worker (NO protocol, NO trailing slash).
# Local dev leaves this unset and the client uses localhost:8787 (wrangler dev).
# In production (e.g. Vercel) set this to your deployed Worker host:
#   VITE_PARTYKIT_HOST=frost.<your-workers-subdomain>.workers.dev
VITE_PARTYKIT_HOST=
